/* bwapi_c2.h -- the BWAPI half of bwapi-c2: lifecycle, versions, the error channel, the two
 * callbacks, the client, and every wrapper over BWAPI::Game, Unit, Player, Force and Region.
 *
 * GENERATED by tools/abi/emit_header.py from tools/abi/spec/ and tools/abi/templates/; do not
 * edit. A change to the ABI is a change to a spec file (docs/spec-format.md), and CI fails when
 * regenerating produces a diff. The one-line comment above each declaration is the first
 * sentence of its reference entry; the whole entry, with the parameters, the neutral value and
 * when it latches, is on the site under /reference/.
 *
 * The conventions are stated once, at the top of bwapi_c2_types.h, and hold for every
 * declaration here. The protocol is section 4.1 of docs/c-abi-plan.md:
 *
 *     while (!bwapi_client_connect()) sleep(1000);
 *     for (;;) {
 *       while (!bwapi_game_is_in_game()) { bwapi_client_update(); if (!bwapi_client_is_connected()) goto reconnect; }
 *       while (bwapi_game_is_in_game()) {
 *         bwapi_clear_last_error();
 *         ... poll events, take snapshots, issue commands ...
 *         bwapi_client_update();                  -- blocks on the pipe
 *         if (!bwapi_client_is_connected()) break;
 *       }
 *     }
 *
 * The two error channels have different lifetimes. bwapi_last_error() is sticky: it latches
 * the FIRST error since the last clear and is never cleared implicitly; successful calls do
 * not touch it and reading does not clear it. Clear it at the top of the frame, check it
 * before update(). BWAPI's own Game::getLastError() is per call and comes back through
 * bwapi_game_get_last_error().
 */
